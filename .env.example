# Leave any key blank and that feature turns off gracefully.

# Tiger Data (TimescaleDB). Blank = local SQLite fallback.
DATABASE_URL=

# FinchNode synthetic health records
FINCHNODE_API_KEY=
FINCHNODE_BASE_URL=
FINCHNODE_PATIENT_ID=

# Google Gemini
GEMINI_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Fetch.ai (Phase 6)
AGENTVERSE_API_KEY=

# Replay synthetic data if the device disconnects during judging
DEMO_MODE=false

# Mute all wrist + laptop audio
QUIET=false

# Figma (optional): pull edited wrist screens back from Figma
FIGMA_TOKEN=
FIGMA_FILE_KEY=

# Photon Spectrum (iMessage). Project ID + secret from https://app.photon.codes -> project Settings.
# Register both phone numbers under Users in the Photon dashboard (free/pro plans only message registered users).
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_PORT=8790
# E.164 numbers, e.g. +15551234567. Never hardcode them in code.
CAREGIVER_PHONE=
PATIENT_PHONE=

# Fetch.ai agent (agent/taptrack_agent.py). AGENT_SEED keeps the agent address stable (any long random string).
AGENT_SEED=
AGENT_PORT=8001
NEUROLOGIST_NAME=Dr. Patel (Movement Disorders Clinic)
# In DEMO_MODE the caregiver gets an iMessage after every live check (not only red ones) so a phone buzzes.
DEMO_ALERT_ALL_CHECKS=true
VOLUME=0.35
